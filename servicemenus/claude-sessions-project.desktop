[Desktop Entry]
Type=Service
MimeType=inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel
X-KDE-RequiredNumberOfUrls=1
X-KDE-Protocols=claude-sessions
Actions=projectFolder

[Desktop Action projectFolder]
Name=Open project folder
Icon=folder-open
Exec=claude-sessions-here --project %u
